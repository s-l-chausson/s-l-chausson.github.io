---
import Base from '../layouts/Base.astro';
import HorizontalTimeline from '../components/HorizontalTimeline';
import type { PubEntry } from '../components/HorizontalTimeline';

// ---------------------------------------------------------------------------
// Fetch publication dates from ORCID at build time
// Only the /works summary endpoint is needed — it already contains
// publication-date (year + month) and external IDs (doi).
// No per-work detail calls required.
// ---------------------------------------------------------------------------
const ORCID_ID  = '0009-0005-4415-4962';
const ORCID_URL = `https://pub.orcid.org/v3.0/${ORCID_ID}/works`;
const HEADERS   = { Accept: 'application/json' };

let publications: PubEntry[] = [];

try {
  const res = await fetch(ORCID_URL, { headers: HEADERS });
  if (res.ok) {
    const data = await res.json() as any;
    const groups: any[] = data.group ?? [];

    publications = groups
      .map((group: any): PubEntry | null => {
        const summary = group['work-summary']?.[0];
        if (!summary) return null;

        const yearStr  = summary['publication-date']?.year?.value;
        const monthStr = summary['publication-date']?.month?.value;
        if (!yearStr) return null;           // skip undated entries

        const extIds: any[] = summary['external-ids']?.['external-id'] ?? [];
        const doiEntry = extIds.find((e: any) => e['external-id-type'] === 'doi');
        const doi = doiEntry?.['external-id-url']?.value ?? null;

        return {
          title: summary.title?.title?.value ?? 'Untitled',
          venue: summary['journal-title']?.value ?? null,
          doi,
          year:  parseInt(yearStr),
          month: monthStr ? parseInt(monthStr) - 1 : 5,  // 0-indexed; default June
        };
      })
      .filter((p): p is PubEntry => p !== null);
  }
} catch {
  // ORCID unreachable at build time — timeline renders without publication dots
}
---

<Base title="Experience" description="Experience and background of Sandrine Chausson.">
  <h1 class="text-2xl font-semibold mb-6">Experience</h1>

  <HorizontalTimeline client:only="react" publications={publications} />
</Base>

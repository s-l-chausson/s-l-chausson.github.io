---
import Base from '../layouts/Base.astro';

// ─── Types ────────────────────────────────────────────────────────────────────
type Role = 'Teaching Assistant' | 'Course Organiser & Lecturer';

interface YearRole { year: string; role: Role }

interface Course {
  title:       string;
  code:        string;
  href:        string;
  school:      string;
  description: string;
  yearRoles:   YearRole[];
}

// ─── Role styling ─────────────────────────────────────────────────────────────
const ROLE_BG:     Record<Role, string> = {
  'Teaching Assistant':          '#f0fdf4',
  'Course Organiser & Lecturer': '#eff6ff',
};
const ROLE_TEXT:   Record<Role, string> = {
  'Teaching Assistant':          '#166534',
  'Course Organiser & Lecturer': '#1e40af',
};
const ROLE_BORDER: Record<Role, string> = {
  'Teaching Assistant':          '#86efac',
  'Course Organiser & Lecturer': '#93c5fd',
};
const ROLE_SHORT:  Record<Role, string> = {
  'Teaching Assistant':          'TA',
  'Course Organiser & Lecturer': 'Organiser',
};

// ─── Course data ──────────────────────────────────────────────────────────────
const courses: Course[] = [
  {
    title: 'Data Science for Society',
    code:  'EFIE11019',
    href:  'https://www.drps.ed.ac.uk/22-23/dpt/cxefie11019.htm',
    school: 'Edinburgh Futures Institute',
    description:
      'Hands-on exploration of diverse real-world datasets to understand and analyse problems ' +
      'of inequality in society. Students learn to relate, visualise, and model numerical data ' +
      'through interactive notebooks, culminating in an intensive project phase.',
    yearRoles: [
      { year: '2022–23', role: 'Teaching Assistant' },
      { year: '2023–24', role: 'Teaching Assistant' },
      { year: '2024–25', role: 'Teaching Assistant' },
    ],
  },
  {
    title: 'Evidence, Argument and Persuasion in a Digital Age',
    code:  'EFIE11080',
    href:  'https://www.drps.ed.ac.uk/22-23/dpt/cxefie11080.htm',
    school: 'Edinburgh Futures Institute',
    description:
      'Examines how information spreads and shapes public opinion in digital environments — ' +
      'from rumours on messaging platforms to bot-driven political discourse — developing ' +
      "students' capacity to critically evaluate evidence and argumentation.",
    yearRoles: [
      { year: '2022–23', role: 'Teaching Assistant' },
      { year: '2023–24', role: 'Teaching Assistant' },
      { year: '2024–25', role: 'Teaching Assistant' },
      { year: '2025–26', role: 'Teaching Assistant' },
    ],
  },
  {
    title: 'Evaluating Sustainable Lands and Cities',
    code:  'EFIE11174',
    href:  'https://www.drps.ed.ac.uk/23-24/dpt/cxefie11174.htm',
    school: 'Edinburgh Futures Institute',
    description:
      'Data-driven evaluation of climate and sustainability challenges facing urban and rural ' +
      'environments, equipping students with frameworks and methods to assess land-use and ' +
      'city-planning decisions against sustainable development goals.',
    yearRoles: [
      { year: '2023–24', role: 'Teaching Assistant' },
      { year: '2024–25', role: 'Course Organiser & Lecturer' },
      { year: '2025–26', role: 'Teaching Assistant' },
    ],
  },
  {
    title: 'Data, Mobility and Infrastructure',
    code:  'EFIE11180',
    href:  'https://www.drps.ed.ac.uk/23-24/dpt/cxefie11180.htm',
    school: 'Edinburgh Futures Institute',
    description:
      'Explores how urban mobility data can help policy-makers design sustainable transport ' +
      'systems centred on active travel. Covers data collection, analysis, and visualisation ' +
      'in the context of global sustainability and UN-Habitat targets.',
    yearRoles: [
      { year: '2023–24', role: 'Teaching Assistant' },
      { year: '2024–25', role: 'Course Organiser & Lecturer' },
      { year: '2025–26', role: 'Teaching Assistant' },
    ],
  },
  {
    title: 'Text Mining for Social Research',
    code:  'EFIE11006',
    href:  'https://www.drps.ed.ac.uk/25-26/dpt/cxefie11006.htm',
    school: 'Edinburgh Futures Institute',
    description:
      'Introduces the theory and practice of computational text analysis using Python, designed ' +
      'for social researchers regardless of prior programming experience. Topics include text ' +
      'preprocessing, corpus analysis, and visualisation for social science questions.',
    yearRoles: [
      { year: '2025–26', role: 'Teaching Assistant' },
    ],
  },
];

// ─── Pre-compute display data ─────────────────────────────────────────────────
// Chips: flat array of { year, short, bg, text, border } per course
const courseDisplay = courses.map(c => ({
  ...c,
  chips: c.yearRoles.map(yr => ({
    year:   yr.year,
    short:  ROLE_SHORT[yr.role],
    bg:     ROLE_BG[yr.role],
    text:   ROLE_TEXT[yr.role],
    border: ROLE_BORDER[yr.role],
  })),
}));

// Legend entries
const legend = (Object.keys(ROLE_BG) as Role[]).map(role => ({
  label:  role,
  bg:     ROLE_BG[role],
  border: ROLE_BORDER[role],
}));
---

<Base title="Teaching" description="Teaching experience of Sandrine Chausson at the University of Edinburgh.">
  <h1 class="text-2xl font-semibold mb-2">Teaching</h1>
  <p class="text-stone-500 mb-10">
    All courses are postgraduate (SCQF Level 11) at the
    <a href="https://efi.ed.ac.uk" target="_blank" rel="noopener"
       class="underline decoration-stone-300 hover:decoration-stone-600 transition-colors">
      Edinburgh Futures Institute
    </a>,
    University of Edinburgh.
  </p>

  <div class="space-y-8">
    {courseDisplay.map(course => (
      <article class="border-l-2 border-stone-200 pl-5">

        <!-- Title row -->
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5 mb-1.5">
          <h2 class="font-medium text-stone-800">
            <a href={course.href} target="_blank" rel="noopener"
               class="hover:text-stone-500 transition-colors">{course.title}</a>
            <span class="text-stone-400 font-normal text-sm ml-2">{course.code}</span>
          </h2>
          <span class="text-xs text-stone-400">{course.school}</span>
        </div>

        <!-- Year / role chips -->
        <div class="flex flex-wrap gap-1.5 mb-2.5">
          {course.chips.map(chip => (
            <span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full border"
                  style={{ background: chip.bg, color: chip.text, borderColor: chip.border }}>
              <span class="font-semibold">{chip.year}</span>
              <span class="opacity-70">{chip.short}</span>
            </span>
          ))}
        </div>

        <!-- Description -->
        <p class="text-sm text-stone-600 leading-relaxed">{course.description}</p>

      </article>
    ))}
  </div>

  <!-- Legend -->
  <div class="mt-10 pt-6 border-t border-stone-100 flex flex-wrap gap-4 text-xs text-stone-500">
    {legend.map(l => (
      <span class="flex items-center gap-1.5">
        <span class="inline-block w-2.5 h-2.5 rounded-full border"
              style={{ background: l.bg, borderColor: l.border }} />
        {l.label}
      </span>
    ))}
  </div>
</Base>

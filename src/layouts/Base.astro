---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Sandrine Chausson',
  description = 'Personal website of Sandrine Chausson — researcher, data scientist.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title === 'Sandrine Chausson' ? title : `${title} · Sandrine Chausson`}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Nav -->
    <header class="border-b border-stone-200 bg-stone-50/80 backdrop-blur sticky top-0 z-50">
      <nav class="max-w-3xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/" class="font-semibold tracking-wide hover:text-stone-500 transition-colors">
          Sandrine Chausson
        </a>
        <ul class="flex flex-wrap gap-x-6 gap-y-1 text-sm text-stone-500">
          <li><a href="/" class="hover:text-stone-800 transition-colors">About</a></li>
          {/* <li><a href="/experience" class="hover:text-stone-800 transition-colors">Experience</a></li> */}
          <li><a href="/publications" class="hover:text-stone-800 transition-colors">Publications</a></li>
          <li><a href="/teaching" class="hover:text-stone-800 transition-colors">Teaching</a></li>
          <li><a href="/projects" class="hover:text-stone-800 transition-colors">Projects</a></li>
          {/* <li><a href="/blog" class="hover:text-stone-800 transition-colors">Blog</a></li> */}
        </ul>
      </nav>
    </header>

    <!-- Content -->
    <main class="flex-1 max-w-3xl mx-auto w-full px-6 py-12">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-stone-200 text-stone-400 text-sm">
      <div class="max-w-3xl mx-auto px-6 py-6 flex justify-between items-center">
        <span>© {new Date().getFullYear()} Sandrine Chausson</span>
        <div class="flex gap-4">
          <a href="https://github.com/s-l-chausson" target="_blank" rel="noopener"
             class="hover:text-stone-600 transition-colors">GitHub</a>
        </div>
      </div>
    </footer>
  </body>
</html>
